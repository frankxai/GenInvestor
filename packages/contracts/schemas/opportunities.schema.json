{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frankxai/GenInvestor/schemas/opportunities.schema.json",
  "title": "Opportunities (opportunities.json)",
  "description": "Candidates for research found against the owner's mandate. There is no field for a recommendation, a price target, a position size or a probability: a suggested call carries none, because the probability is the owner's own.",
  "type": "object",
  "required": ["date", "screen", "cards", "disclosure"],
  "additionalProperties": false,
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "disclosure": { "type": "string", "minLength": 40 },
    "screen": {
      "type": "object",
      "required": ["mandate", "stylesRun", "stylesUnavailable", "thresholds", "thresholdsFromDefaults", "universe", "screened", "passed", "skippedHeld", "skippedExcluded", "noData", "ranAt"],
      "additionalProperties": false,
      "properties": {
        "mandate": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
        "stylesRun": { "type": "array", "items": { "enum": ["quality", "growth"] } },
        "stylesUnavailable": {
          "type": "array",
          "items": { "type": "object", "required": ["style", "reason"], "additionalProperties": false, "properties": { "style": { "type": "string" }, "reason": { "type": "string" } } }
        },
        "thresholds": {
          "type": "object",
          "required": ["minRevenueGrowthPct", "minOperatingMarginPct", "maxLiabilitiesToEquity"],
          "additionalProperties": false,
          "properties": { "minRevenueGrowthPct": { "type": "number" }, "minOperatingMarginPct": { "type": "number" }, "maxLiabilitiesToEquity": { "type": "number" } }
        },
        "thresholdsFromDefaults": { "type": "array", "items": { "type": "string" } },
        "universe": { "type": "integer", "minimum": 0 },
        "screened": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "skippedHeld": { "type": "integer", "minimum": 0 },
        "skippedExcluded": { "type": "integer", "minimum": 0 },
        "noData": {
          "type": "array",
          "items": { "type": "object", "required": ["ticker", "reason"], "additionalProperties": false, "properties": { "ticker": { "type": "string" }, "reason": { "type": "string" } } }
        },
        "ranAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ticker", "name", "mandate", "asOf", "filedAt", "style", "score", "whyPassed", "wouldProveWrong", "caseAgainst", "risks", "checkNext", "suggestedCall", "sourceId"],
        "additionalProperties": false,
        "properties": {
          "ticker": { "type": "string", "pattern": "^[A-Z0-9.\\-]{1,10}$" },
          "name": { "type": "string", "minLength": 1 },
          "mandate": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
          "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "filedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "style": { "enum": ["quality", "growth"] },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "sourceId": { "type": "string", "minLength": 1 },
          "whyPassed": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "object", "required": ["text", "claimIds"], "additionalProperties": false, "properties": { "text": { "type": "string", "minLength": 1 }, "claimIds": { "type": "array", "items": { "type": "string" } } } }
          },
          "wouldProveWrong": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "object", "required": ["text", "claimIds"], "additionalProperties": false, "properties": { "text": { "type": "string", "minLength": 1 }, "claimIds": { "type": "array", "items": { "type": "string" } } } }
          },
          "caseAgainst": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "object", "required": ["text", "claimIds"], "additionalProperties": false, "properties": { "text": { "type": "string", "minLength": 1 }, "claimIds": { "type": "array", "items": { "type": "string" } } } }
          },
          "risks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "checkNext": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "suggestedCall": {
            "type": "object",
            "required": ["claim", "resolvesOn", "resolutionSource", "note"],
            "additionalProperties": false,
            "properties": {
              "claim": { "type": "string", "minLength": 1 },
              "resolvesOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "resolutionSource": { "type": "string", "minLength": 5 },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
