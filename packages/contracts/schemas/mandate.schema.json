{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frankxai/GenInvestor/schemas/mandate.schema.json",
  "title": "Mandate",
  "description": "The owner's own written rules. Everything the opportunity team searches is judged against this. Local only: it is never written into a brief, a card or the ledger, and holdings never leave it.",
  "type": "object",
  "required": ["version", "name", "markets", "horizonYears", "riskTolerance", "styles", "watchlist"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "markets": { "type": "array", "minItems": 1, "items": { "enum": ["us-equities", "eu-equities", "crypto"] } },
    "horizonYears": { "type": "number", "minimum": 1, "maximum": 50 },
    "riskTolerance": { "enum": ["low", "medium", "high"] },
    "styles": { "type": "array", "minItems": 1, "items": { "enum": ["quality", "growth", "value", "special-situation"] } },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tickers": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9.\\-]{1,10}$" } },
        "keywords": { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 40 } }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxPositionPct": { "type": "number", "minimum": 0.5, "maximum": 100 },
        "maxSectorPct": { "type": "number", "minimum": 1, "maximum": 100 }
      }
    },
    "thresholds": {
      "type": "object",
      "description": "Screen thresholds. Defaults apply when a value is absent.",
      "additionalProperties": false,
      "properties": {
        "minRevenueGrowthPct": { "type": "number", "minimum": -50, "maximum": 500 },
        "minOperatingMarginPct": { "type": "number", "minimum": -100, "maximum": 100 },
        "maxLiabilitiesToEquity": { "type": "number", "minimum": 0, "maximum": 50 }
      }
    },
    "watchlist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ticker"],
        "additionalProperties": false,
        "properties": {
          "ticker": { "type": "string", "pattern": "^[A-Z0-9.\\-]{1,10}$" },
          "cik": { "type": "string", "pattern": "^\\d{1,10}$" }
        }
      }
    },
    "holdings": {
      "type": "array",
      "description": "Tickers you already hold, used only to skip them. Never published.",
      "items": { "type": "string", "pattern": "^[A-Z0-9.\\-]{1,10}$" }
    }
  }
}
