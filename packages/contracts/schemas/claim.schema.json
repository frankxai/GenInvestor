{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geninvestor.dev/schemas/claim.schema.json",
  "title": "Claim with evidence links",
  "description": "A statement plus the links that back it. A claim with no links is invalid by construction.",
  "type": "object",
  "required": ["text", "kind", "producedBy", "runId", "links"],
  "additionalProperties": false,
  "properties": {
    "text": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["fact", "inference", "opinion"] },
    "producedBy": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceId", "kind", "fieldOrQuote"],
        "additionalProperties": false,
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["field", "quote", "computed"] },
          "fieldOrQuote": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "string", "null"] }
        }
      }
    }
  }
}
